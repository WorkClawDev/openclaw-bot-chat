{
  "name": "@openclaw/openclaw-bot-chat",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw-side BotChat runtime plugin",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "doctor": "npm run build && node dist/doctor.js",
    "ci": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "pdf-lib": "1.17.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "mammoth": "1.13.0",
    "mqtt": "^5.15.1",
    "pdfjs-dist": "6.3.289",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
