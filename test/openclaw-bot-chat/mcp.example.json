{
  "mcpServers": {
    "filesystem": {
      "command": "replace-with-installed-filesystem-mcp-command",
      "args": ["/workspace/input"],
      "tools": {
        "read_file": {
          "capabilities": ["read"],
          "idempotent": true,
          "approvalRequired": false,
          "paths": [{"argument": "path", "roots": ["/workspace/input"], "allowHidden": false}]
        }
      }
    }
  }
}
