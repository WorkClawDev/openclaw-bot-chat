log.console_handler.level = warning
listeners.tcp.default.bind = "0.0.0.0:1883"
listeners.ws.default.bind = "0.0.0.0:8083"
authentication = [{
 mechanism = password_based
 backend = http
 method = post
 url = "http://backend:8080/internal/broker/authentication"
 headers = {"content-type" = "application/json", "X-Broker-Token" = "__BROKER_CALLBACK_TOKEN__"}
 body = {username = "${username}", password = "${password}", clientid = "${clientid}"}
 request_timeout = "3s"
}]
authorization {
 no_match = deny
 deny_action = disconnect
 cache.enable = false
 sources = [{
  type = http
  method = post
  url = "http://backend:8080/internal/broker/authorization"
  headers = {"content-type" = "application/json", "X-Broker-Token" = "__BROKER_CALLBACK_TOKEN__"}
  body = {username = "${username}", clientid = "${clientid}", action = "${action}", topic = "${topic}"}
  request_timeout = "3s"
 }]
}
