# Copy to .env (ignored), then run scripts/personal-agent-prepare.cjs.
PERSONAL_AGENT_ENV=isolated
# Select a prebuilt image (release/registry digest or a locally loaded image).
# See docs/MQTTS_ACCESS.md; this repository never builds broker source.
MQTTS_IMAGE=mqtts:local
OPENAI_COMPAT_BASE_URL=https://your-provider.example/v1
OPENAI_COMPAT_MODEL=replace-model-name
# No model key or bot key is stored in this file; fill .runtime/model-key and bot-key.
